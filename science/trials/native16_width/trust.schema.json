{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mimo:owned-recovery:1",
  "title": "Owner trusted recovery documents",
  "description": "Select $defs/config, receipt or authorization. CLI additionally checks exact retained values, paths, hashes, timestamp ordering, process scope and source policy. Schema is documentation; no network resolver is used.",
  "oneOf": [
    {
      "$ref": "#/$defs/config"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/authorization"
    }
  ],
  "$defs": {
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "starttime",
        "args"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "starttime": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guard_pid",
        "server_pid",
        "command"
      ],
      "properties": {
        "guard_pid": {
          "type": "integer",
          "minimum": 1
        },
        "server_pid": {
          "type": "integer",
          "minimum": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "pids",
        "processes"
      ],
      "properties": {
        "run": {
          "type": "string",
          "pattern": "^/"
        },
        "pids": {
          "$ref": "#/$defs/pids"
        },
        "processes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/process"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "ppid",
        "pgid",
        "sid",
        "cgroup",
        "cgroupns",
        "netns",
        "mntns",
        "exe",
        "environment"
      ],
      "properties": {
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "ppid": {
          "type": "integer",
          "minimum": 0
        },
        "pgid": {
          "type": "integer",
          "minimum": 1
        },
        "sid": {
          "type": "integer",
          "minimum": 1
        },
        "cgroup": {
          "type": "string"
        },
        "cgroupns": {
          "type": "string"
        },
        "netns": {
          "type": "string"
        },
        "mntns": {
          "type": "string"
        },
        "exe": {
          "type": "string",
          "pattern": "^/"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "width": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error"
          ],
          "properties": {
            "status": {
              "const": "passed"
            },
            "error": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error"
          ],
          "properties": {
            "status": {
              "const": "failed"
            },
            "error": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "phase",
        "captured_at",
        "boot_id",
        "uid",
        "owner",
        "scopes",
        "launch_sha256",
        "live_config_sha256"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "phase": {
          "const": "pre_failure"
        },
        "captured_at": {
          "type": "number"
        },
        "boot_id": {
          "type": "string"
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "scopes": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 2,
          "patternProperties": {
            "^[1-9][0-9]*$": {
              "$ref": "#/$defs/scope"
            }
          },
          "additionalProperties": false
        },
        "launch_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "live_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "intent",
        "root",
        "operator_lock",
        "ingress_blocked",
        "uid",
        "boot_id",
        "config_sha256",
        "receipt_sha256",
        "issued_at",
        "failure_at",
        "expires_at",
        "width"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "intent": {
          "const": "stop_owned_then_launch_retained_once"
        },
        "root": {
          "const": "/workspace/mimo-tune"
        },
        "operator_lock": {
          "type": "string"
        },
        "ingress_blocked": {
          "const": true
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        },
        "boot_id": {
          "type": "string"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "issued_at": {
          "type": "number"
        },
        "failure_at": {
          "type": "number"
        },
        "expires_at": {
          "type": "number"
        },
        "width": {
          "$ref": "#/$defs/width"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "guard",
            "launcher",
            "server",
            "source",
            "dso",
            "interpreter",
            "target_config",
            "drafter_config",
            "source_manifest"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_pin",
        "root",
        "operator_lock",
        "active",
        "live_config",
        "server_lock",
        "guard_argv",
        "launcher_argv",
        "launcher_env",
        "retained",
        "identities",
        "port",
        "new_run_prefix",
        "receipt_dir",
        "timeouts"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "source_pin": {
          "const": "ca4a880e8918e1985fd25e06c6aff561666d3f14"
        },
        "root": {
          "const": "/workspace/mimo-tune"
        },
        "operator_lock": {
          "type": "string"
        },
        "active": {
          "const": "france-active-run.txt"
        },
        "live_config": {
          "const": "france-uma.json"
        },
        "server_lock": {
          "const": "server.lock"
        },
        "guard_argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "launcher_argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "launcher_env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "retained": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memory_policy",
            "max_seconds",
            "env",
            "command"
          ],
          "properties": {
            "memory_policy": {
              "const": "uma"
            },
            "max_seconds": {
              "const": 43200
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "identities": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "port": {
          "const": 8096
        },
        "new_run_prefix": {
          "const": "france-round6-quant-readback-"
        },
        "receipt_dir": {
          "type": "string"
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stop",
            "headroom",
            "launch",
            "ready",
            "http"
          ],
          "properties": {
            "stop": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 120
            },
            "headroom": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 120
            },
            "launch": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 120
            },
            "ready": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 500
            },
            "http": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            }
          }
        }
      }
    }
  }
}