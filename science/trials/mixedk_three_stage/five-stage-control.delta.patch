+#pragma once
+
+#include "exl3_moe_kernel.cuh"
+
+// Experimental MiMo decode schedule. Five ordinary stream-ordered launches replace
+// the persistent expert loop. Scratch is per sorted assignment, NOT per worker group.
+// Each GEMM CTA owns complete K for one N tile; no CTA waits on another CTA.
+// The host restricts this to mul1 / gated SiLU / H4096 I2048 / <=8 tokens / top8.
+// Quantized bytes, rotations, half stores and final weighted-slot ABI are unchanged.
+// STAGE: 0 gather+input rotations, 1 gate/up, 2 activation+down rotation,
+//        3 down, 4 output rotation+weighted slot store.
+template<int STAGE>
+__global__ __launch_bounds__(512)
+void exl3_moe_phased_kernel(EXL3_MOE_MIXEDK_KERNEL_ARGS)
+{
+    // One CTA per eligible-expert ordinal, bounded by assignment count on the host.
+    // No shared work queue: each CTA independently derives its immutable span.
+    __shared__ int span[2];
+    if (threadIdx.x == 0)
+    {
+        int start = 0, active = 0;
+        span[0] = -1;
+        for (int e = 0; e < num_experts; ++e)
+        {
+            const int count = expert_count[e];
+            if (count > 0 && count <= max_tokens_per_expert && count >= count_lo && count <= count_hi)
+            {
+                if (active++ == (int) blockIdx.z)
+                {
+                    span[0] = e;
+                    span[1] = start;
+                    break;
+                }
+            }
+            start += count;
+        }
+    }
+    __syncthreads();
+    const int expert = span[0];
+    if (expert < 0) return;
+    const int rows = expert_count[expert];
+    // Match the incumbent's tier/overflow contract; caller still owns overflow fallback.
+    if (rows == 0 || rows > max_tokens_per_expert || rows < count_lo || rows > count_hi) return;
+    const int start = span[1];
+    half* g = temp_state_g + (size_t) start * hidden_dim;
+    half* u = temp_state_u + (size_t) start * hidden_dim;
+    half* ig = temp_intermediate_g + (size_t) start * intermediate_dim;
+    half* iu = temp_intermediate_u + (size_t) start * intermediate_dim;
+    const int warp = threadIdx.x / 32;
+    const int warps = blockDim.x / 32;
+    constexpr float scale = 0.088388347648f;
+
+    if constexpr (STAGE == 0)
+    {
+        const int chunks = hidden_dim / 128;
+        for (int w = warp; w < rows * chunks; w += warps)
+        {
+            const int row = w / chunks;
+            const int col = (w % chunks) * 128;
+            const half* x = hidden_state + token_sorted[start + row] * hidden_dim + col;
+            had_hf_r_128_inner<true, false>(x, g + w * 128, gate_suh[expert] + col, scale);
+            had_hf_r_128_inner<true, false>(x, u + w * 128, up_suh[expert] + col, scale);
+        }
+    }
+    if constexpr (STAGE == 1 || STAGE == 3)
+    {
+        const bool gate = STAGE == 1 && blockIdx.y == 0;
+        const int k = STAGE == 1 ? hidden_dim : intermediate_dim;
+        const int n = STAGE == 1 ? intermediate_dim : hidden_dim;
+        const half* a = STAGE == 3 ? ig : (gate ? g : u);
+        half* c = STAGE == 3 ? g : (gate ? ig : iu);
+        const uint16_t* b = STAGE == 3 ? down_trellis[expert] :
+                                        (gate ? gate_trellis[expert] : up_trellis[expert]);
+        const int K = STAGE == 3 ? K_down_arr[expert] :
+                                  (gate ? K_gate_arr[expert] : K_up_arr[expert]);
+        // Also safe for duplicate synthetic picks >8 rows: process every eligible row,
+        // never truncate an expert at the decode-row bound. Production top-k is unique.
+        for (int row = 0; row < rows; row += 16)
+            moe_gemm_tile<0, 2, 16, 256, 3, 3, true>
+                (a + (size_t) row * k, b, c + (size_t) row * n,
+                 rows - row, k, n, nullptr, K);
+    }
+    if constexpr (STAGE == 2)
+    {
+        const int chunks = intermediate_dim / 128;
+        for (int w = warp; w < rows * chunks; w += warps)
+        {
+            const int col = (w % chunks) * 128;
+            had_hf_r_128_guad_inner(ig + w * 128, iu + w * 128, ig + w * 128,
+                gate_svh[expert] + col, up_svh[expert] + col, down_suh[expert] + col,
+                scale, act_limit, act_function);
+        }
+    }
+    if constexpr (STAGE == 4)
+    {
+        const int chunks = hidden_dim / 128;
+        for (int w = warp; w < rows * chunks; w += warps)
+        {
+            const int row = w / chunks;
+            const int col = (w % chunks) * 128;
+            float* dst = output_scratch + (fused_base[expert] + row) * hidden_dim + col;
+            had_hf_r_128_d_inner<false>(g + w * 128, dst, down_svh[expert] + col,
+                scale * __half2float(weight_sorted[start + row]));
+        }
+    }
+}
